# DocuQuality Environment Variables
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./docuquality.db
UPLOAD_DIR=./uploads
CONFIG_FILE=./config.yaml
ENABLE_OCR=true
# Optional custom Tesseract path (Windows: C:\Program Files\Tesseract-OCR\tesseract.exe, Linux/macOS: /usr/bin/tesseract)
TESSERACT_CMD=
DEBUG=true
