# DocuQuality Frontend Environment Variables

# Backend API Base URL
# Option 1: Empty or /api uses the Vite local dev proxy or Netlify reverse proxy (Recommended)
# VITE_API_URL=/api

# Option 2: Direct connection to production Render backend
VITE_API_URL=https://document-image-quality-assessment-and.onrender.com/api

# Option 3: Direct connection to local backend
# VITE_API_URL=http://127.0.0.1:8000/api
